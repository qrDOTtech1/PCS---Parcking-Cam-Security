# ParkingCamSecurity - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Clé secrète Flask (générer une clé aléatoire sécurisée)
FLASK_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# Clé master pour l'API admin (à changer absolument !)
MASTER_KEY=CHANGE_ME_TO_YOUR_MASTER_KEY

# URL de la base de données
# Railway la configure automatiquement via $DATABASE_URL
# Pour SQLite local : sqlite:///parkingcam.db
DATABASE_URL=sqlite:///parkingcam.db

# URL publique du serveur (pour les redirections, liens, etc.)
# Exemple Railway : https://your-app.up.railway.app
SERVER_URL=https://CHANGE_ME.railway.app
